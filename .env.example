# Salin file ini menjadi .env lalu isi nilainya. JANGAN commit file .env.

# Supabase > Project Settings > Database > Connection string
# Dipakai aplikasi (pooler, port 6543, "Transaction" mode):
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Dipakai migrasi & seed (koneksi "Session" mode, port 5432):
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Super Admin pertama (hanya dipakai saat seed; wajib diganti saat login pertama)
SEED_ADMIN_LOGIN="admin"
SEED_ADMIN_PASSWORD=""

APP_TIMEZONE="Asia/Jakarta"

# Penyimpanan foto absensi (Supabase > Project Settings > API Keys).
# Kunci "secret"/"service_role" = rahasia: hanya di .env dan Vercel, jangan di kode/chat.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

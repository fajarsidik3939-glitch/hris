// Skema HRIS. Desain lengkap: docs/DATABASE_DESIGN.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth & RBAC ----------

enum PermissionScope {
  OWN
  TEAM
  DEPARTMENT
  ALL
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  loginId            String    @unique @map("login_id")
  email              String?   @unique
  // Nama tampilan untuk akun tanpa data karyawan (mis. Super Admin).
  displayName        String    @map("display_name")
  passwordHash       String    @map("password_hash")
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  sessions  Session[]
  roles     UserRole[]
  auditLogs AuditLog[]
  employee  Employee?

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model LoginAttempt {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  ip         String
  success    Boolean
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([identifier, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  isSystem  Boolean  @default(false) @map("is_system")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  code        String @unique
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String          @map("role_id") @db.Uuid
  permissionId String          @map("permission_id") @db.Uuid
  scope        PermissionScope

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

// ---------- Organisasi & karyawan ----------

enum EmploymentType {
  PKWTT
  PKWT
  HARIAN
  MAGANG
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum WorkType {
  OFFICE
  SHIFT
  FIELD
}

enum AttendanceMethod {
  SELFIE_GPS
  FINGERPRINT
  BOTH
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  legalName String?  @map("legal_name")
  address   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  branches Branch[]

  @@map("companies")
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  code      String   @unique
  name      String
  address   String?
  timezone  String   @default("Asia/Jakarta")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  workLocations WorkLocation[]
  holidays      Holiday[]
  employees     Employee[]

  @@map("branches")
}

model Department {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  employees Employee[]

  @@map("departments")
}

model Position {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  employees Employee[]

  @@map("positions")
}

model WorkLocation {
  id        String   @id @default(uuid()) @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  name      String
  latitude  Decimal  @db.Decimal(9, 6)
  longitude Decimal  @db.Decimal(9, 6)
  // CHECK 10–5000 ada di migrasi.
  radiusM   Int      @default(100) @map("radius_m")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  branch Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  events AttendanceEvent[]

  @@index([branchId])
  @@map("work_locations")
}

// Unique (date, branch_id) NULLS NOT DISTINCT dibuat manual di migrasi.
model Holiday {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @db.Date
  name      String
  branchId  String?  @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([date])
  @@map("holidays")
}

model Employee {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String?          @unique @map("user_id") @db.Uuid
  employeeCode      String           @unique @map("employee_code")
  fullName          String           @map("full_name")
  email             String?
  phone             String?
  branchId          String           @map("branch_id") @db.Uuid
  departmentId      String           @map("department_id") @db.Uuid
  positionId        String           @map("position_id") @db.Uuid
  // CHECK manager_id <> id ada di migrasi; siklus dicegah di aplikasi.
  managerId         String?          @map("manager_id") @db.Uuid
  hireDate          DateTime         @map("hire_date") @db.Date
  endDate           DateTime?        @map("end_date") @db.Date
  employmentType    EmploymentType   @map("employment_type")
  status            EmployeeStatus   @default(ACTIVE)
  workType          WorkType         @map("work_type")
  attendanceMethod  AttendanceMethod @map("attendance_method")
  fingerprintUserId String?          @unique @map("fingerprint_user_id")
  defaultShiftId    String?          @map("default_shift_id") @db.Uuid
  // 1 = Senin … 7 = Minggu
  workDays          Int[]            @default([1, 2, 3, 4, 5]) @map("work_days") @db.SmallInt
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  user             User?              @relation(fields: [userId], references: [id], onDelete: Restrict)
  branch           Branch             @relation(fields: [branchId], references: [id], onDelete: Restrict)
  department       Department         @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  position         Position           @relation(fields: [positionId], references: [id], onDelete: Restrict)
  manager          Employee?          @relation("Reports", fields: [managerId], references: [id], onDelete: Restrict)
  subordinates     Employee[]         @relation("Reports")
  defaultShift     Shift?             @relation(fields: [defaultShiftId], references: [id], onDelete: Restrict)
  attendance       AttendanceRecord[]
  attendanceEvents AttendanceEvent[]

  @@index([branchId])
  @@index([departmentId])
  @@index([managerId])
  @@map("employees")
}

// ---------- Shift & absensi ----------

// Jam disimpan sebagai menit sejak 00:00 WIB (0–1439); end < start = shift lintas tengah malam.
model Shift {
  id               String   @id @default(uuid()) @db.Uuid
  code             String   @unique
  name             String
  startMinute      Int      @map("start_minute")
  endMinute        Int      @map("end_minute")
  lateToleranceMin Int      @default(15) @map("late_tolerance_min")
  clockInWindowMin Int      @default(240) @map("clock_in_window_min")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  employees Employee[]
  records   AttendanceRecord[]

  @@map("shifts")
}

enum AttendanceEventType {
  IN
  OUT
  SCAN
}

enum AttendanceSource {
  SELFIE
  FINGERPRINT
  CORRECTION
}

enum LocationLabel {
  IN_RADIUS
  OUT_OF_RADIUS
  LOW_ACCURACY
  FIELD
  FINGERPRINT
}

// Satu baris = satu karyawan × satu tanggal kerja (tanggal mulai shift).
model AttendanceRecord {
  id                String         @id @default(uuid()) @db.Uuid
  employeeId        String         @map("employee_id") @db.Uuid
  workDate          DateTime       @map("work_date") @db.Date
  shiftId           String?        @map("shift_id") @db.Uuid
  scheduledStart    DateTime?      @map("scheduled_start") @db.Timestamptz
  scheduledEnd      DateTime?      @map("scheduled_end") @db.Timestamptz
  clockInAt         DateTime?      @map("clock_in_at") @db.Timestamptz
  clockOutAt        DateTime?      @map("clock_out_at") @db.Timestamptz
  lateMinutes       Int            @default(0) @map("late_minutes")
  earlyLeaveMinutes Int            @default(0) @map("early_leave_minutes")
  workMinutes       Int            @default(0) @map("work_minutes")
  clockInLabel      LocationLabel? @map("clock_in_label")
  clockOutLabel     LocationLabel? @map("clock_out_label")
  hasCorrection     Boolean        @default(false) @map("has_correction")
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  shift    Shift?            @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  events   AttendanceEvent[]

  @@unique([employeeId, workDate])
  @@index([workDate])
  @@map("attendance_records")
}

// Setiap tap selfie / scan / koreksi; tidak pernah diubah atau dihapus.
model AttendanceEvent {
  id                 String              @id @default(uuid()) @db.Uuid
  attendanceRecordId String              @map("attendance_record_id") @db.Uuid
  employeeId         String              @map("employee_id") @db.Uuid
  type               AttendanceEventType
  source             AttendanceSource
  occurredAt         DateTime            @map("occurred_at") @db.Timestamptz
  latitude           Decimal?            @db.Decimal(9, 6)
  longitude          Decimal?            @db.Decimal(9, 6)
  accuracyM          Decimal?            @map("accuracy_m") @db.Decimal(8, 1)
  distanceM          Int?                @map("distance_m")
  workLocationId     String?             @map("work_location_id") @db.Uuid
  locationLabel      LocationLabel?      @map("location_label")
  photoPath          String?             @map("photo_path")
  ip                 String?
  userAgent          String?             @map("user_agent")
  idempotencyKey     String?             @unique @map("idempotency_key")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz

  record       AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Restrict)
  employee     Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  workLocation WorkLocation?    @relation(fields: [workLocationId], references: [id], onDelete: Restrict)

  @@unique([employeeId, source, occurredAt])
  @@index([attendanceRecordId])
  @@map("attendance_events")
}

// ---------- Audit & pengaturan ----------

// Append-only: trigger di migrasi menolak UPDATE/DELETE.
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  before      Json?
  after       Json?
  reason      String?
  ip          String?
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedBy String?  @map("updated_by") @db.Uuid
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("system_settings")
}
